# ──────────────────────────────────────────────────────────────
# Central Church Admin Panel — Environment Variables
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local to Git. Add all values to Vercel env.
# ──────────────────────────────────────────────────────────────

# ── Supabase ──────────────────────────────────────────────────
# Found in: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://REPLACE_PROJECT_ID.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=REPLACE_ANON_KEY

# Service role key — server-side ONLY (never exposed to browser)
# Found in: Supabase Dashboard → Project Settings → API
SUPABASE_SERVICE_ROLE_KEY=REPLACE_SERVICE_ROLE_KEY
