# ── Environment secrets — NEVER commit these ──────────────────
.env
.env.local
.env.*.local
*.env
# Always commit *.example files (safe templates)
!*.example

# ── Node ──────────────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── Expo / React Native ───────────────────────────────────────
.expo/
dist/
web-build/
android/
ios/
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.orig.*

# ── EAS ───────────────────────────────────────────────────────
# Service account keys used for store submission
google-play-service-account.json
google-services.json

# ── Next.js (admin panel) ─────────────────────────────────────
.next/
out/
.vercel

# ── Supabase ──────────────────────────────────────────────────
# Local Supabase docker volumes and generated types
supabase/.branches/
supabase/.temp/
# Edge function secrets file (use .env.example as template)
supabase/functions/.env

# ── OS ────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
