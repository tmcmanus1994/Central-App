# ──────────────────────────────────────────────────────────────
# Central Church App — Environment Variables
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local to Git.
# ──────────────────────────────────────────────────────────────

# ── Supabase ──────────────────────────────────────────────────
# Found in: Supabase Dashboard → Project Settings → API
EXPO_PUBLIC_SUPABASE_URL=https://REPLACE_PROJECT_ID.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=REPLACE_ANON_KEY

# ── OneSignal ─────────────────────────────────────────────────
# Found in: OneSignal Dashboard → Settings → Keys & IDs
EXPO_PUBLIC_ONESIGNAL_APP_ID=REPLACE_ONESIGNAL_APP_ID

# ── App Environment ───────────────────────────────────────────
EXPO_PUBLIC_APP_ENV=development
