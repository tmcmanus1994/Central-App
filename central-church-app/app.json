{
  "expo": {
    "name": "Central Church",
    "slug": "central-church-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "centralchurch",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FDFAF4"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.centralchurch.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FDFAF4"
      },
      "package": "com.centralchurch.app"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "Central Church uses your photos to set your profile picture."
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "Central Church needs calendar access to add events."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
