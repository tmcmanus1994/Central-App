# Edge Function Secrets
# Set these via: supabase secrets set KEY=value
# Or for production: supabase secrets set --env-file ./supabase/functions/.env
#
# NEVER commit a .env file with real values. This file is the template only.

# ── OneSignal (send-notification function) ────────────────────
ONESIGNAL_APP_ID=REPLACE_ONESIGNAL_APP_ID
ONESIGNAL_REST_API_KEY=REPLACE_ONESIGNAL_REST_API_KEY

# ── Google Calendar (sync-google-calendar function) ───────────
# Comma-separated list of Google Calendar IDs to sync
# Each calendar must be set to "Public" visibility in Google Calendar settings
GOOGLE_CALENDAR_IDS=primary@group.calendar.google.com,events@group.calendar.google.com
GOOGLE_CALENDAR_API_KEY=REPLACE_GOOGLE_API_KEY
